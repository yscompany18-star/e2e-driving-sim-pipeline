{
 "repo": "yscompany18-star/e2e-driving-sim-pipeline",
 "sections": [
  {
   "id": "s_ol",
   "label": "Open-loop Simulation",
   "rq": "RQ1",
   "color": "0E7C66",
   "q": "실주행 로그만으로 정적·동적 장면을 편집 가능한 형태로 고충실도 복원할 수 있는가?",
   "short": "로그를 편집 가능한 장면으로 복원",
   "problems": [
    "정적 배경과 동적 객체의 분리 (라벨 노이즈·가림)",
    "희소한 단일 궤적 관측으로 인한 미관측 영역",
    "복원된 장면을 편집(삽입·삭제·궤적 변경)할 수 있는 표현"
   ]
  },
  {
   "id": "s_cl",
   "label": "Closed-loop Simulation",
   "rq": "RQ2",
   "color": "4F46B8",
   "q": "Ego가 로그 궤적에서 벗어날 때도 센서 품질과 주변 에이전트의 반응성을 유지할 수 있는가?",
   "short": "궤적 이탈에도 센서·에이전트 현실성 유지",
   "problems": [
    "novel view(차선 이동 등)에서의 렌더링 artifact",
    "log-replay 에이전트의 비반응성 vs 재현성(world-on-rails) trade-off",
    "다중 에이전트 상호작용의 현실성"
   ]
  },
  {
   "id": "s_req",
   "label": "Simulation Requirement",
   "rq": "RQ3",
   "color": "B4581A",
   "q": "시뮬레이션 결과가 실차 성능을 얼마나 신뢰성 있게 예측하는가?",
   "short": "시뮬 결과가 실차 성능을 예측하는가",
   "problems": [
    "자사 센서 구성·타이밍과의 동기화",
    "충돌률 등 지표의 타당성",
    "대규모 평가를 위한 속도",
    "렌더링 품질과 sim-to-real gap",
    "자사 모델 포함 공정 비교 환경"
   ]
  },
  {
   "id": "s_eval",
   "label": "Evaluation Process",
   "rq": "RQ4",
   "color": "B3264A",
   "q": "실차의 inference-to-actuation 지연을 시뮬레이터에서 재현해 평가 왜곡을 막을 수 있는가?",
   "short": "실차 지연을 재현해 평가 왜곡 제거",
   "problems": [
    "모델 추론·제어·렌더링 지연의 분리 계측",
    "지연을 반영한 closed-loop step 동기화"
   ]
  },
  {
   "id": "s_aug",
   "label": "Data Augmentation",
   "rq": "RQ5",
   "color": "3C7A1E",
   "q": "롱테일·안전임계 시나리오를 생성·발굴해 평가와 학습 커버리지를 넓힐 수 있는가?",
   "short": "롱테일 시나리오 생성·발굴",
   "problems": [
    "현실적인 신규 시나리오 생성",
    "기존 로그에서 희귀 시나리오 검색",
    "생성·발굴 시나리오를 World Model로 센서 수준 렌더링"
   ]
  }
 ],
 "nodes": [
  {
   "id": "root",
   "kind": "root",
   "label": "Simulation"
  },
  {
   "id": "dsr",
   "kind": "task",
   "sec": "s_ol",
   "label": "Driving Scene Reconstruction",
   "problem": "어떤 표현(NeRF/3DGS/3DGUT)이 렌더링 속도·품질·편집성을 동시에 만족하는가?"
  },
  {
   "id": "static",
   "kind": "scene",
   "sec": "s_ol",
   "label": "Static Scene",
   "problem": "동적 객체를 제거한 깨끗한 배경과 미관측 영역 처리."
  },
  {
   "id": "dynamic",
   "kind": "scene",
   "sec": "s_ol",
   "label": "Dynamic Scene",
   "problem": "노이즈 있는 박스·포즈로부터 비강체까지 정확히 복원."
  },
  {
   "id": "reactive",
   "kind": "task",
   "sec": "s_cl",
   "label": "Reactive Simulation",
   "problem": "반응성을 켰을 때 로그와의 일관성·재현성을 어떻게 유지하는가?"
  },
  {
   "id": "egotraj",
   "kind": "task",
   "sec": "s_cl",
   "label": "Following Ego Vehicle Trajectory",
   "problem": "로그 궤적에서 멀어질수록 커지는 렌더링 artifact."
  },
  {
   "id": "sync",
   "kind": "task",
   "sec": "s_req",
   "label": "자사 데이터 Sensor 동기화",
   "problem": "센서 간 시간 오프셋·왜곡 모델 불일치가 복원 품질과 정책 입력을 왜곡."
  },
  {
   "id": "metrics",
   "kind": "task",
   "sec": "s_req",
   "label": "Metrics-based Evaluation",
   "sub": "AlpaSim · Collision rate",
   "problem": "이진 충돌률만으로 안전성을 판단할 수 있는가? 심각도·책임 구분 필요."
  },
  {
   "id": "speed",
   "kind": "task",
   "sec": "s_req",
   "label": "Simulation Speed",
   "problem": "렌더링·생성 모델 비용이 평가 규모를 제한."
  },
  {
   "id": "render",
   "kind": "task",
   "sec": "s_req",
   "label": "Rendering Quality",
   "problem": "PSNR 같은 영상 지표와 closed-loop 지표 간 상관 확보."
  },
  {
   "id": "e2ecmp",
   "kind": "task",
   "sec": "s_req",
   "label": "E2E Model Comparison 환경",
   "sub": "자사 모델 포함",
   "problem": "모델마다 다른 센서 입력·주기를 공통 인터페이스로 맞추기."
  },
  {
   "id": "sim2real",
   "kind": "task",
   "sec": "s_req",
   "label": "Sim-to-Real gap 최소화",
   "problem": "시뮬 지표가 실차 성능의 대리 지표로 타당한지 검증."
  },
  {
   "id": "latency",
   "kind": "task",
   "sec": "s_eval",
   "label": "E2E Inference-to-Actuation Latency 동기화",
   "problem": "지연을 무시하면 시뮬에서 과대평가된 성능이 나옴."
  },
  {
   "id": "scengen",
   "kind": "task",
   "sec": "s_aug",
   "label": "Scenario Generation",
   "sub": "Scenario Dreamer",
   "problem": "현실적이면서 도전적인(adversarial) 시나리오 생성."
  },
  {
   "id": "scenmine",
   "kind": "task",
   "sec": "s_aug",
   "label": "Scenario Mining",
   "sub": "Scenario Dreamer",
   "problem": "Scenario Dreamer는 생성 모델이므로, 검색(mining) 측면은 별도 방법과 결합 필요."
  },
  {
   "id": "edit",
   "kind": "tech",
   "label": "Driving Scene Editing",
   "sub": "World-on-Rails",
   "problem": "편집 후에도 물리적·시각적 일관성 유지."
  },
  {
   "id": "multiagent",
   "kind": "tech",
   "label": "Multi-Agent Simulation",
   "problem": "다수 에이전트의 현실적·제어 가능한 동시 행동 생성."
  },
  {
   "id": "rqi",
   "kind": "tech",
   "label": "Reconstruction Quality Improvement",
   "sub": "ArtiFixer · OneFixer",
   "problem": "실시간성(online)과 시간적 일관성을 동시에 만족."
  },
  {
   "id": "gcomp",
   "kind": "tech",
   "label": "Gaussian Compression",
   "problem": "압축률 대비 렌더링 품질(→정책 행동) 손실 최소화."
  },
  {
   "id": "sensorplat",
   "kind": "tech",
   "label": "Sensor Integration Platform",
   "sub": "NVIDIA · NCore · NuRec · AlpaSim",
   "problem": "자사 센서 rig(카메라 모델·셔터·LiDAR·타이밍)를 NCore/NuRec이 지원하는 형태로 정확히 옮기는 것. NuRec 공식 지원 rig 외 구성에서의 품질 저하 검증 필요."
  },
  {
   "id": "wm",
   "kind": "wm",
   "label": "World Model",
   "sub": "Conditional Generation · Cosmos-Transfer",
   "problem": "조건 충실도와 멀티뷰·시간 일관성, 그리고 실시간성."
  }
